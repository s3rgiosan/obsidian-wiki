{
  "manifest_version": 3,
  "name": "Brain",
  "description": "Capture pages into your Obsidian brain vault, and fill web forms from it using your existing Claude Code / Codex subscription.",
  "version": "0.2.0",
  "action": {
    "default_title": "Brain",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "key": ""
}
